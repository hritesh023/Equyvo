# ── Frontend (.env) — PUBLIC values only. Never put secrets here. ──
# Anything with VITE_ is bundled into the JS and visible to anyone.
# Backend secrets (Cloudinary API secret, R2 keys, billing keys) live ONLY in
# Cloudflare Pages/Workers secrets + server Env, never here.

# Centralized Auth Server URL
VITE_AUTH_URL=https://auth.acronous.com

# Cognito (public IDs — safe to expose; verification happens server-side)
VITE_AWS_USER_POOL_ID=eu-north-1_xxxxxxxxx
VITE_AWS_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=eu-north-1

# Optional: Acronous brain base URL (public endpoint)
# VITE_BRAIN_API_URL=https://ai.acronous.com

# Razorpay Key ID (PUBLIC ONLY — safe with VITE_ prefix).
# The checkout key_id is normally supplied per-order by the billing server
# (src/lib/billing.ts uses the server-returned key), so this is only a
# fallback hint. NEVER create VITE_RAZORPAY_KEY_SECRET — the secret lives
# ONLY in Cloudflare Pages secrets / the central billing worker.
# VITE_RAZORPAY_KEY_ID=rzp_test_XXXX

# ── AdMob (Native apps) — PUBLIC IDs, safe to expose ──
# App ID is also declared in AndroidManifest.xml / Info.plist.
VITE_ADMOB_APP_ID=ca-app-pub-8929153950560106~6452994138
VITE_ADMOB_NATIVE_AD_UNIT=ca-app-pub-8929153950560106/1659832454
# Banner unit for the adaptive feed banner (real Google fill on Android/iOS).
# Create a *Banner* ad unit in AdMob console and paste its ID here.
# Empty = banner off (in-feed house promo still shows).
VITE_ADMOB_BANNER_AD_UNIT=ca-app-pub-8929153950560106/3009794330
# Comma-separated advertising test-device IDs for real-device testing.
VITE_ADMOB_TEST_DEVICES=
# ── AdSense (Web — equyvo.com) — PUBLIC IDs, safe to expose ──
# AdMob has NO web SDK, so web earning needs AdSense. Create an account at
# https://www.google.com/adsense, verify equyvo.com, create an "In-article"
# responsive ad unit, then paste its IDs here. Empty = house promo fallback.
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_SLOT=XXXXXXXXXX
# Master switch: false disables all sponsored slots (e.g. staging).
VITE_ADS_ENABLED=true

# ── Backend (Cloudflare Pages/Workers secrets — NEVER VITE_) ──
# Set via dashboard or `wrangler pages secret put`:
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_UPLOAD_PRESET,
#   CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET,
#   AWS_USER_POOL_ID,
#   BILLING_BASE_URL=https://api.acronous.com,
#   REQUIRE_VERIFIED_WRITES=true  (production),
#   R2_PUBLIC_BASE=https://cdn.equyvo.com (when EQUYVO_R2 bound),
#   ALLOWED_ORIGINS=https://equyvo.com,https://www.equyvo.com
# Media warehouse: bind R2 bucket as EQUYVO_R2 (see wrangler.toml).
