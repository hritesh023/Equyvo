<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Single app window colour. Matches the web shell background so a
         window resize (keyboard open/close, rotation) can only ever reveal a
         flat app-coloured surface — never a splash image or app icon. -->
    <color name="equyvo_window_bg">#0a0a0a</color>

    <!-- Legacy AppCompat palette (kept so AppTheme stays resolvable). -->
    <color name="colorPrimary">#0ea5e9</color>
    <color name="colorPrimaryDark">#0a0a0a</color>
    <color name="colorAccent">#22d3ee</color>
</resources>
