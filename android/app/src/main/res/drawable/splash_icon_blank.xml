<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent placeholder used as the Android 12+ splash-screen icon.
     The real launch experience is the in-app web splash (SplashScreen.tsx),
     so the OS-level starting window must never paint an enlarged app logo
     behind the WebView (it could flash for a frame during window resizes,
     e.g. when the soft keyboard opens). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
